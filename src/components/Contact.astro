---
// Contact.astro (Institutional Clean Mode - Responsive & Overflow Protected)
---

<section id="contacto" class="contact-section">
  <div class="contact-container">
    <div class="contact-wrapper">
      <div class="header-center">
        <span class="badge-section">Contacto Institucional</span>
