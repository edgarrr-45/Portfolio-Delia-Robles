          Disponible para coordinación de programas de sustentabilidad, asesoría en criterios ESG y gobernanza climática, dirección de proyectos de electromovilidad y misiones técnicas multilaterales.
        </p>
      </div>

      <div class="contact-cards-grid">
        <!-- Correo Electrónico -->
        <a href="mailto:rogadelia10@gmail.com" class="channel-card">
          <div class="channel-svg-box">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </div>
          <div class="channel-details">
            <span class="ch-type">Correo Electrónico</span>
            <span class="ch-value">rogadelia10@gmail.com</span>
            <span class="ch-sub">Convocatorias y enlace institucional</span>
          </div>
        </a>

        <!-- LinkedIn -->
        <a href="https://linkedin.com/in/delia-robles-0604763a3" target="_blank" rel="noopener noreferrer" class="channel-card">
          <div class="channel-svg-box">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </div>
          <div class="channel-details">
            <span class="ch-type">LinkedIn Profesional</span>
            <span class="ch-value">in/delia-robles</span>
            <span class="ch-sub">Red ejecutiva y proyectos</span>
          </div>
        </a>

        <!-- Instagram -->
        <a href="https://www.instagram.com/del_roga" target="_blank" rel="noopener noreferrer" class="channel-card">
          <div class="channel-svg-box">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </div>
          <div class="channel-details">
            <span class="ch-type">Instagram</span>
            <span class="ch-value">@del_roga</span>
            <span class="ch-sub">Divulgación y actividades STEM</span>
          </div>
        </a>

        <!-- Teléfono -->
        <a href="tel:+525541902086" class="channel-card">
          <div class="channel-svg-box">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <div class="channel-details">
            <span class="ch-type">Línea Telefónica / WhatsApp</span>
            <span class="ch-value">+52 55 4190 2086</span>
            <span class="ch-sub">Contacto directo</span>
          </div>
        </a>

        <!-- Ubicación -->
        <div class="channel-card">
          <div class="channel-svg-box">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
